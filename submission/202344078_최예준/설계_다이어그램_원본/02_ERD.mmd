erDiagram
 users ||--o{ orders : "초기 SQL FK"
 restaurants ||--o{ menus : "초기 SQL FK"
 orders ||--o{ order_items : "초기 SQL FK"
 menus ||--o{ order_items : "초기 SQL FK"
 users { int id PK
 varchar username
 varchar password
 varchar nickname
 datetime created_at
 varchar address "ALTER 확인"
 }
 restaurants { int id PK
 varchar name
 varchar category
 varchar description
 varchar image
 unknown address "추가 DDL 미확인"
 }
 menus { int id PK
 int restaurant_id FK
 varchar name
 int price
 int calories
 varchar description
 varchar image
 }
 orders { int id PK
 int user_id FK
 datetime order_date
 int total_price
 int total_calories
 unknown delivery_address "추가 DDL 미확인"
 }
 order_items { int id PK
 int order_id FK
 int menu_id FK
 int quantity
 int price
 int calories
 }
%% PK/FK는 저장된 초기 SQL 기준; 운영 DB 제약은 미확인
